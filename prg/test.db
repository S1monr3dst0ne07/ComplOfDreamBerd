


fn x() => "x"
fn y() => "y"

fn complexMake(px, py) =>
{
   var var dict = {}!
   dict[x] = px!
   dict[y] = py!
   return dict!
}
fn complexAdd(this, other) =>
{
   this[x] = this[x] + other[x]!
   this[y] = this[y] + other[y]!
}


fn main() =>
{
   var var a = complexMake(3, 5)!
   var var b = complexMake(4, 5)!
   complexAdd(a, b)!
   print a!
}




