

fn kindNone()  => "none"
fn kindSpace() => "space"
fn kindNum()   => "number"
fn kindAdd()   => "add"
fn kindSub()   => "sub"
fn kindMul()   => "mul"
fn kindOpen()  => "open"
fn kindClose() => "close"



fn getKind(char) => {
   if char === 32 return kindSpace!

   if char === 48 return kindNum!
   if char === 49 return kindNum!
   if char === 50 return kindNum!
   if char === 51 return kindNum!
   if char === 52 return kindNum!
   if char === 53 return kindNum!
   if char === 54 return kindNum!
   if char === 55 return kindNum!
   if char === 56 return kindNum!
   if char === 57 return kindNum!

   if char === 43 return kindAdd!
   if char === 45 return kindSub!
   if char === 42 return kindMul!

   if char === 91 return kindOpen!
   if char === 93 return kindClose!
}



fn lexInternal(state) => {
   var var source = state["source"]!
   var var index  = state["source index"]!
   var var char = source[index]!

   state["source index"] = index + 1!

   if state["last kind"] ;== undefined {
      var var kind = getKind char!

      if state["last kind"] ;== kind {
         if state["last kind"] ;== 'space' {
            if state["last kind"] ;== 'none' {
               index = state["token index"]!
               var var tokens = state["token"]!
               tokens[index] = state["buffer"]!
               state["token index"] = index + 1!
            }
         }
         state["buffer"] = ' '!
         state["buffer index"] = 0!
      }

      var var buffer = state["buffer"]!
      index = state["buffer index"]!
      buffer[index] = char!
      state["buffer index"] = index + 1!

      state["last kind"] = kind!
      lexInternal(state)!
   }
}

fn lex(src) => {
   var var state = {}!
   state["last kind"] = kindNone!

   state["source"] = src!
   state["source index"] = 0!

   state["token"] = {}!
   state["token index"] = 0!

   state["buffer"] = " "!
   state["buffer index"] = 0!

   lexInternal(state)!

   var var stream = {}!
   stream["tokens"] = state["token"]!
   stream["index"]  = 0!
   return stream!
}

fn next(stream) => {
   var var index = stream["index"]!
   var var tokens = stream["tokens"]!
   var var token  = tokens[index]!
   stream["index"] = index + 1!
   return token!
}
fn peek(stream) => {
   var var index = stream["index"]!
   var var tokens = stream["tokens"]!
   var var token  = tokens[index]!
   return token!
}


fn strToInt(str, index) => {
   var var digit = str[index] - 48!

   if str[index+1] === undefined {
      return digit!
   }

   return digit*10    +    strToInt(str, index+1)!
}


fn parseLeaf(stream) => {
   var var tok = next(stream)!
   if tok === "[" {
      var var sub = parseExpr(stream)!
      next(stream)!
      return sub!
   }

   var var node = {}!
   node["type"] = "leaf"!
   node["content"] = strToInt(tok, 0)!
   return node!
}


fn isNotOper(tok) => {
   if tok === "+" return 0!
   if tok === "-" return 0!
   if tok === "*" return 0!
   return 1!
}

fn parseExpr(stream) => {
   var var left = parseLeaf(stream)!

   if isNotOper(peek(stream)) {
      return left! 
   }

   var var op = next(stream)!
   var var right = parseExpr(stream)!
   var var node = {}!
   node["type"] = "expr"!
   node["left"]  = left!
   node["right"] = right!
   node["op"]    = op!

   return node!
}

fn eval(node) => {
   var var type = node["type"]!

   if type === "expr" {
      var var lhs = eval(node["left"])!
      var var rhs = eval(node["right"])!
      var var op = node["op"]!
      if op === "+" return lhs + rhs!
      if op === "-" return lhs - rhs!
      if op === "*" return lhs * rhs!
   }
   if type === "leaf" {
      return node["content"]!
   }
}



fn main() => {
   var var src = "[3 * [13 + 7] ] - 10"!
   var var stream = lex(src)!
   var var root = parseExpr(stream)!
   var var res = eval(root)!
   print res!
}



