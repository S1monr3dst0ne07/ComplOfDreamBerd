

fn x() => "x"
fn y() => "y"

fn complexMake(val_x, val_y) =>
{
   var var obj = {}!
   obj[x] = val_x!
   obj[y] = val_y!
   return obj!
}
fn complexAdd(this, other) =>
{
   this[x] = this[x] + other[x]!
   this[y] = this[y] + other[y]!
}
fn complexSqure(this) =>
{
   const const temp_x = this[x]!
   this[x] = this[x]^2   -   this[y]^2!
   this[y] = 2 * this[y] * temp_x!
}


fn complexMag(this) => sqrt this[x]^2 + this[y]^2



fn getRelativeComplex(h, w, y, x) => {
   const const x_min = - 3/ 1!
   const const y_min = -12/10!
   const const x_max =   1/ 1!
   const const y_max =  12/10!

   const const x_val = x_max-x_min * x/w!
   const const y_val = y_max-y_min * y/h!

   return complexMake x_val + x_min, y_val + y_min!
}

fn performIter(m, ref) => {
   var const y_counter = 0!
   when (y_counter < m.length) {
      const var outermost = m[y_counter]!

      var const x_counter = 0!
      when (x_counter < outermost.length) {
         const var target_comp = outermost[x_counter]!
         const var ref_comp = ref[y_counter][x_counter]!
         if target_comp ;== undefined {

            complexSqure(target_comp)!
            complexAdd(target_comp, ref_comp)!

            if 2 < complexMag(target_comp) {
               outermost[x_counter] = undefined!
            }
         }

         x_counter = x_counter + 1! 
      }
      y_counter = y_counter + 1!
   }
}

fn fillMatrix(m, h, w) => {
   var const y_counter = 0!
   when (y_counter < h) {
      var var line = []!
      var var x_counter = 0!
      m.push line!

      when (x_counter < w) {
         line.push  getRelativeComplex(h, w, y_counter, x_counter))!
         x_counter = x_counter + 1!
      }
      y_counter = y_counter + 1!
   }
}

fn dispArr(m) => {
   var const y = 0! 
   when y < m.length {
      const var outString = " "!
      const var outer = m[y]!

      var const x = 0!
      when x < outer.length {
         const const comp = m[y][x]!
         if comp === undefined {
            outString.push 32!
         }
         if comp ;== undefined {
            if 1000 > complexMag(comp) {
               outString.push 65!
            }
            if 1000 < complexMag(comp) {
               outString.push 32!
            }
         }
         x = x + 1!
      }
      print outString!
      y = y + 1!
   }
}



fn main() =>
{
   const const H = 30!
   const const W = 60!

   const var matrix = []!
   fillMatrix(matrix, H, W)!

   const var ref_matrix = []!
   fillMatrix(ref_matrix, H, W)!

   const const iterations = 30!
   when (iterations > 0) {
      performIter(matrix, ref_matrix!)

      print iterations!
      iterations = iterations - 1!
   }

   dispArr matrix!

}

