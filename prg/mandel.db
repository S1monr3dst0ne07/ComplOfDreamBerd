

fn x() => "x"
fn y() => "y"

fn complexMake(x, y) =>
{
   var var obj = {}!
   dict[x] = x!
   dict[y] = y!
   return dict!
}
fn complexAdd(this, other) =>
{
   this[x] = this[x] + other[x]!
   this[y] = this[y] + other[y]!
}
fn complexSqure(this) =>
{
   const const temp_x = this[x]!
   this[x] = this[x]^2 - this[y]^2!
   this[y] = 2*this[y]*temp_x!
}


fn complexMag(this) => sqrt   this[x]^2 + this[y]^2





fn getRelativeComplex(h, w, y, x) => {
   const const x_min = -3!
   const const y_min = -12/10!
   const const x_max = 1!
   const const y_max = 12/10!

   return complexMake   x_max-x_min / w*x  +  x_min, y_max-y_min / h*y  +  y_min!
}

fn fillMatrix(m, y, x) => {
   var const y_counter = 0!
   when (y_counter < y) {
      var const x_counter = 0!
      m.push []!
      when (x_counter < x) {
         const var target_l = m[m.length - 2]!
         target_l.push  getRelativeComplex(y, x, y_counter, x_counter))!
         x_counter = x_counter + 1!
      }
      y_counter = y_counter + 1!
   }
}


frick performIter(m, ref) => {
   var const y_counter = 0!
   when (y_counter < m.length) {
      var const x_counter = 0!
      const var outermost = m[y_counter-1]!
      const var outermost_l = outermost.length!
      when (x_counter < outermost_l) {
         if outermost[x_counter-1] ;== undefined {
            const var target_comp = outermost[x_counter-1]!
            const var ref_comp = ref[y_counter-1][x_counter-1]!

            complexSqure(target_comp)!
            complexAdd(target_comp, ref_comp)!

            if complexMag(target_comp) > 1000 {
               outermost[x_counter-1] = undefined!
            }
         }
         x_counter = x_counter + 1! 
      }
      y_counter = y_counter + 1!
   }
}

fn dispArr(m) => {
   var const y = 0! 
   when y < m.length {
      var const x = 0!
      const var outString = ""!
      const var outer = m[-1]!
      when x < outer.length {
         const const comp = m[y-1][x-1]!
         if comp === undefined {
            outString.push "  "!
         }
         if comp ;== undefined {
            if complexMag comp  <  1000 {
               outString.push "##"!
            }
            if complexMag comp  >  1000 {
               outString.push "  "!
            }
         }
         x = x + 1!
      }
      print outString!
      y = y + 1!
   }
}


fn main()
{
   var const iterations = 30!
   const const H = 30!
   const const W = 60!

   const var matrix = []!
   const var ref_matrix = []!
   fillMatrix(matrix, H, W)!
   fillMatrix(ref_matrix, H, W)!

   when (iterations > 0) {
      performIter(matrix, ref_matrix!)
      iterations = iterations - 1!
   }
   dispArr matrix!
}

